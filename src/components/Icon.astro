---
interface Props {
  name: 'instagram' | 'phone' | 'pin' | 'arrow';
}

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
  {
    name === 'instagram' && (
      <>
        <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="4" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'phone' && (
      <path d="M8.2 3.8h2.2l1.1 3.2-1.7 1.1a11.2 11.2 0 0 0 5.1 5.1l1.1-1.7 3.2 1.1v2.2a1.8 1.8 0 0 1-1.8 1.8A14.4 14.4 0 0 1 6.4 5.6a1.8 1.8 0 0 1 1.8-1.8Z" />
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s6.2-5.5 6.2-10.1a6.2 6.2 0 1 0-12.4 0C5.8 15.5 12 21 12 21Z" />
        <circle cx="12" cy="10.6" r="1.8" />
      </>
    )
  }
  {name === 'arrow' && <path d="M12 5v14M6.5 13.5 12 19l5.5-5.5" />}
</svg>
