---
import '../styles/global.scss';
import { addressInline, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.title,
  description = site.description,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageUrl = new URL('/ogp.jpg', Astro.site ?? Astro.url);
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressInline)}`;
const pageId = `${pageUrl.href}#webpage`;
const businessId = `${pageUrl.href}#bar`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${pageUrl.href}#website`,
      name: site.name,
      alternateName: site.alternateName,
      url: pageUrl.href,
      inLanguage: 'ja',
    },
    {
      '@type': 'WebPage',
      '@id': pageId,
      url: pageUrl.href,
      name: title,
      description,
      inLanguage: 'ja',
      isPartOf: { '@id': `${pageUrl.href}#website` },
      about: { '@id': businessId },
      primaryImageOfPage: { '@id': `${pageUrl.href}#primary-image` },
    },
    {
      '@type': 'ImageObject',
      '@id': `${pageUrl.href}#primary-image`,
      url: imageUrl.href,
      contentUrl: imageUrl.href,
      width: 1200,
      height: 630,
      caption: '宮崎市上野町 barAZITOの店内',
    },
    {
      '@type': 'BarOrPub',
      '@id': businessId,
      name: site.name,
      alternateName: site.alternateName,
      description,
      url: pageUrl.href,
      image: imageUrl.href,
      telephone: '+81-90-1923-6404',
      currenciesAccepted: 'JPY',
      publicAccess: true,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${site.street} ${site.building}`,
        addressLocality: site.city,
        addressRegion: site.region,
        addressCountry: 'JP',
      },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: [
          'Monday',
          'Tuesday',
          'Wednesday',
          'Thursday',
          'Friday',
          'Saturday',
          'Sunday',
        ],
        opens: '21:00',
        closes: '05:00',
        description: '平日・土日祝とも同じ。定休日は不定休',
      },
      hasMap: mapUrl,
      sameAs: [site.instagramUrl],
      mainEntityOfPage: { '@id': pageId },
    },
  ],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#0c0c0c" />
    <meta name="geo.region" content="JP-45" />
    <meta name="geo.placename" content="宮崎市上野町" />
    <link rel="canonical" href={pageUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="宮崎市上野町 barAZITOの店内" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content="宮崎市上野町 barAZITOの店内" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500&family=Shippori+Mincho:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500&family=Shippori+Mincho:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#top">本文へスキップ</a>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
